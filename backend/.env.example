# Copia este archivo a backend/.env y rellena los valores reales. NUNCA subas backend/.env a Git.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave service_role: SOLO en el servidor, nunca en el frontend ni en Git
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=http://localhost:3000
PORT=4000
# Exige sesión con segundo factor (aal2). Déjalo en true en producción.
REQUIRE_MFA=true
# Número de proxies de confianza delante del backend (0 si se expone directo)
TRUST_PROXY=1

# En producción debe ser https://
MOODLE_URL=http://localhost/moodle
MOODLE_TOKEN=
MOODLE_ROLE_STUDENT=5
MOODLE_ROLE_TEACHER=3
